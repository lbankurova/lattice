#!/bin/bash
#
# Pre-commit hook: review gate check, executor TypeScript build, advisories.
# Gate and build failures abort the commit. Advisories are non-blocking.
#
# Install: cp this file to <project>/.git/hooks/pre-commit && chmod +x

REPO_ROOT="$(git rev-parse --show-toplevel)"
EXECUTOR_DIR="$REPO_ROOT/executor"

STAGED_FILES=$(git diff --cached --name-only)

echo "========================================"
echo "  Pre-commit hook: running checks..."
echo "========================================"
echo ""

# --- Step 0: Review gate check (BLOCKS) ---
GATE_FILE="$REPO_ROOT/.lattice/review-gate.json"
GATE_MAX_AGE=1800

if [ -f "$GATE_FILE" ]; then
    GATE_TIME=$(stat -c %Y "$GATE_FILE" 2>/dev/null || stat -f %m "$GATE_FILE" 2>/dev/null || echo 0)
    NOW=$(date +%s)
    GATE_AGE=$((NOW - GATE_TIME))

    if [ "$GATE_AGE" -gt "$GATE_MAX_AGE" ]; then
        echo "  REVIEW GATE: Gate file is stale (${GATE_AGE}s old, max ${GATE_MAX_AGE}s)."
        echo "  Re-run /lattice:review before committing."
        exit 1
    fi

    echo "--- Review gate: PASS (age: ${GATE_AGE}s) ---"
    echo ""
else
    echo "========================================"
    echo "  COMMIT BLOCKED: No review gate found."
    echo ""
    echo "  Every commit requires /lattice:review to pass first."
    echo "  Run /lattice:review -- it writes the gate file when all checks pass."
    echo ""
    echo "  For trivial commits (docs-only, typo, comment):"
    echo "  bash scripts/write-review-gate.sh pass \"trivial fix\""
    echo "========================================"
    exit 1
fi

# --- Step 1: Executor TypeScript build (if executor changed) ---
STAGED_EXECUTOR=$(echo "$STAGED_FILES" | grep -c "^executor/" || true)
if [ "$STAGED_EXECUTOR" -gt 0 ]; then
    echo "--- Step 1: Executor TypeScript build ---"
    echo ""
    if (cd "$EXECUTOR_DIR" && npx tsc --noEmit); then
        echo ""
        echo "  Build passed."
        echo ""
    else
        echo ""
        echo "========================================"
        echo "  COMMIT ABORTED: Executor TypeScript build failed."
        echo "  Run: cd executor && npx tsc --noEmit"
        echo "========================================"
        exit 1
    fi
else
    echo "No executor changes staged -- skipping TypeScript check."
    echo ""
fi

# --- Step 2: Index freshness advisories (non-blocking) ---
echo "--- Step 2: Index freshness ---"
echo ""

INDEX_WARNINGS=""
CODE_FILE_COUNT=$(echo "$STAGED_FILES" | grep -cE '\.(ts|md|yaml|sh)$' || true)

if [ "$CODE_FILE_COUNT" -gt 3 ]; then
    TODO_STAGED=$(echo "$STAGED_FILES" | grep -c "TODO.md" || true)
    if [ "$TODO_STAGED" -eq 0 ]; then
        INDEX_WARNINGS="${INDEX_WARNINGS}  TODO.md: ${CODE_FILE_COUNT} files changed but TODO.md was not updated.\n"
    fi
fi

# Docs freshness: structural changes should update README/WORKFLOW/WORKFLOW-INTERNALS/ENFORCEMENT
STRUCT_CHANGES=$(echo "$STAGED_FILES" | grep -cE '^(executor/src/|commands/|workflows/|scripts/|agents/|hooks/|scaffold/)' || true)
if [ "$STRUCT_CHANGES" -gt 0 ]; then
    DOCS_STAGED=$(echo "$STAGED_FILES" | grep -cE '^(README\.md|WORKFLOW\.md|WORKFLOW-INTERNALS\.md|ENFORCEMENT\.md)$' || true)
    if [ "$DOCS_STAGED" -eq 0 ]; then
        INDEX_WARNINGS="${INDEX_WARNINGS}  DOCS: ${STRUCT_CHANGES} structural file(s) changed but README / WORKFLOW / WORKFLOW-INTERNALS / ENFORCEMENT not updated.\n"
    fi
fi

if [ -n "$INDEX_WARNINGS" ]; then
    echo "  Advisories (non-blocking):"
    echo -e "$INDEX_WARNINGS"
else
    echo "  All indexes look fresh."
fi
echo ""

# --- Step 3: Complexity advisories (non-blocking) ---
echo "--- Step 3: Complexity advisories ---"
echo ""

COMPLEXITY_WARNINGS=""

while IFS= read -r FILE; do
    [ -z "$FILE" ] && continue
    [ ! -f "$REPO_ROOT/$FILE" ] && continue
    case "$FILE" in
        *.ts)
            LINE_COUNT=$(wc -l < "$REPO_ROOT/$FILE" 2>/dev/null)
            if [ "$LINE_COUNT" -gt 800 ]; then
                COMPLEXITY_WARNINGS="${COMPLEXITY_WARNINGS}  WARNING: ${FILE} is ${LINE_COUNT} lines (threshold: 800)\n"
            fi
            ;;
        *.md)
            LINE_COUNT=$(wc -l < "$REPO_ROOT/$FILE" 2>/dev/null)
            if [ "$LINE_COUNT" -gt 500 ]; then
                COMPLEXITY_WARNINGS="${COMPLEXITY_WARNINGS}  ADVISORY: ${FILE} is ${LINE_COUNT} lines -- consider splitting\n"
            fi
            ;;
    esac
done <<< "$STAGED_FILES"

if [ -n "$COMPLEXITY_WARNINGS" ]; then
    echo -e "$COMPLEXITY_WARNINGS"
else
    echo "  No advisories."
fi
echo ""

# --- Cleanup: Consume the review gate (single-use) ---
if [ -f "$GATE_FILE" ]; then
    rm -f "$GATE_FILE"
    echo "  Review gate consumed (next commit needs fresh /lattice:review)."
    echo ""
fi

echo "========================================"
echo "  All pre-commit checks passed."
echo "========================================"
exit 0
