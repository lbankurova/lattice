#!/bin/bash
#
# Pre-commit hook: review gate check, executor TypeScript build, advisories.
# Gate and build failures abort the commit. Advisories are non-blocking.
#
# Install: cp this file to <project>/.git/hooks/pre-commit && chmod +x

REPO_ROOT="$(git rev-parse --show-toplevel)"
EXECUTOR_DIR="$REPO_ROOT/executor"

STAGED_FILES=$(git diff --cached --name-only)

# Staging-drift detection: capture the staged-file set at hook entry. After
# all checks complete (some take >10s), we re-snapshot and BLOCK if files
# were added during the hook run -- typically caused by concurrent autopilot
# `git add` interleaving with manual commits. Two confirmed conflation events
# in this codebase (commits 1370c103 and 521f1d16) shipped unrelated work
# bundled into commits with mismatched messages. See decisions.log entries
# tagged `history-annotation`/`CONFLATED-COMMIT` for context.
INITIAL_STAGED_SNAPSHOT=$(echo "$STAGED_FILES" | sort)

echo "========================================"
echo "  Pre-commit hook: running checks..."
echo "========================================"
echo ""

# --- Step -1: Commit-lock acquisition (BLOCKS on concurrent commits) ---
# Universal commit serialization. The first pre-commit to enter holds
# `.lattice/commit.lock/`; concurrent commits queue (--poll, 30s interval,
# 10min max) or block. This prevents the conflation pattern where two
# commit cycles overlap and one snapshots the other's pre-staged files
# (commit a47ee865 in pcc was the third occurrence in a single session).
# The lock is held through the entire pre-commit run and released on EXIT
# via trap -- including failure paths and signals.
#
# Outer-held lock (LATTICE_LOCK_HOLDER): when an enclosing workflow
# (autopilot, /lattice:review, manual scripted commit) acquires the lock
# BEFORE running `git add` -- the correct discipline -- it sets
# LATTICE_LOCK_HOLDER=<holder-name> in the environment. This pre-commit
# checks the lock metadata; if the holder matches LATTICE_LOCK_HOLDER, we
# DO NOT re-acquire and DO NOT release on exit. The outer workflow owns
# the lock lifecycle. This avoids the deadlock where the outer workflow
# holds the lock and the pre-commit blocks waiting to acquire it.
LOCK_SCRIPT="$REPO_ROOT/scripts/acquire-lock.sh"
RELEASE_SCRIPT="$REPO_ROOT/scripts/release-lock.sh"
LOCK_DIR="$REPO_ROOT/.lattice/commit.lock"
LOCK_HELD_BY_HOOK=0
LOCK_OUTER_OWNED=0
if [ -x "$LOCK_SCRIPT" ] && [ -x "$RELEASE_SCRIPT" ]; then
    echo "--- Step -1: Commit lock ---"
    # First: check for outer-held lock (LATTICE_LOCK_HOLDER set + matches metadata)
    if [ -n "${LATTICE_LOCK_HOLDER:-}" ] && [ -f "$LOCK_DIR/meta" ]; then
        HELD_BY=$(grep -E "^holder:" "$LOCK_DIR/meta" | sed 's/holder:[[:space:]]*//')
        if [ "$HELD_BY" = "$LATTICE_LOCK_HOLDER" ]; then
            LOCK_OUTER_OWNED=1
            echo "  Lock held by outer workflow: $LATTICE_LOCK_HOLDER (skipping re-acquire)"
            echo ""
        fi
    fi
    if [ "$LOCK_OUTER_OWNED" = "0" ]; then
        HOLDER="pre-commit-pid-$$"
        # Pass our PID so PID-liveness check (C1) treats this lock as
        # held while pre-commit runs. The lock is released via the EXIT
        # trap below, so the live-PID guarantee covers the whole hook.
        if (cd "$REPO_ROOT" && LATTICE_LOCK_PID=$$ bash "$LOCK_SCRIPT" "$HOLDER" --poll); then
            LOCK_HELD_BY_HOOK=1
            # Release on ANY exit path (success, failure, signal).
            trap '[ "$LOCK_HELD_BY_HOOK" = "1" ] && (cd "$REPO_ROOT" && bash "$RELEASE_SCRIPT" >/dev/null 2>&1 || true)' EXIT INT TERM
            echo ""
        else
            echo ""
            echo "  COMMIT BLOCKED: could not acquire commit lock after polling."
            echo "  Another commit is in progress and exceeded the poll-wait window."
            echo "  Resolve: wait for the other commit to finish, or check"
            echo "  .lattice/commit.lock/meta to identify the holder. If stale,"
            echo "  delete .lattice/commit.lock/ manually and retry."
            echo ""
            echo "  If your workflow already acquired the lock externally, set"
            echo "  LATTICE_LOCK_HOLDER=<your-holder-name> matching the metadata"
            echo "  to skip re-acquisition in this hook."
            exit 1
        fi
    fi
else
    # Lock scripts not installed -- continue without serialization.
    echo "--- Step -1: Commit lock (SKIPPED: scripts/acquire-lock.sh not found) ---"
    echo "  Concurrent commits are NOT serialized in this repo."
    echo "  Install via: bash <lattice>/scripts/sync-skills.sh <repo-root>"
    echo ""
fi

# --- Step 0a: Merge shared state (C3, 2026-05-05 audit) ---
# scripts/merge-shared-state.sh refreshes shared-state files (TODO.md,
# REGISTRY.md, decisions.log, ROADMAP.md, MANIFEST.md) from git HEAD and
# re-applies local additions on top, so a concurrent agent's commit to
# the same shared file is not silently overwritten. It runs AFTER the
# commit lock is acquired (Step -1) and BEFORE the rest of the gate
# checks, so any merge-time tweaks to working-tree files are visible to
# subsequent staging-drift / freshness checks.
#
# Soft-fail if the script is missing -- consumer projects that have not
# yet synced this update should not be blocked by its absence.
MERGE_SCRIPT="$REPO_ROOT/scripts/merge-shared-state.sh"
if [ -x "$MERGE_SCRIPT" ]; then
    echo "--- Step 0a: Shared-state merge ---"
    if (cd "$REPO_ROOT" && bash "$MERGE_SCRIPT"); then
        echo ""
    else
        echo ""
        echo "  WARNING: merge-shared-state.sh exited non-zero. Continuing -- merge"
        echo "           failures should be visible above. If a shared file ended"
        echo "           up with conflict markers, resolve manually before retry."
        echo ""
    fi
else
    echo "--- Step 0a: Shared-state merge (SKIPPED: scripts/merge-shared-state.sh not found) ---"
    echo "  Concurrent shared-file edits are NOT auto-merged in this repo."
    echo "  Install via: bash <lattice>/scripts/sync-skills.sh <repo-root>"
    echo ""
fi

# --- Step 0: Review gate check (BLOCKS) ---
GATE_FILE="$REPO_ROOT/.lattice/review-gate.json"
GATE_MAX_AGE=1800

if [ -f "$GATE_FILE" ]; then
    GATE_TIME=$(stat -c %Y "$GATE_FILE" 2>/dev/null || stat -f %m "$GATE_FILE" 2>/dev/null || echo 0)
    NOW=$(date +%s)
    GATE_AGE=$((NOW - GATE_TIME))

    if [ "$GATE_AGE" -gt "$GATE_MAX_AGE" ]; then
        echo "  REVIEW GATE: Gate file is stale (${GATE_AGE}s old, max ${GATE_MAX_AGE}s)."
        echo "  Re-run /lattice:review before committing."
        exit 1
    fi

    echo "--- Review gate: PASS (age: ${GATE_AGE}s) ---"
    # Surface attestations recorded in the gate (SIMPLIFY-1 unified format).
    # Validation already happened at write-review-gate.sh time; this is purely
    # informational so the committer can see what F3/F6/F7 etc. attached.
    if command -v python > /dev/null 2>&1; then
        export _GATE_FILE_DISPLAY="$GATE_FILE"
        ATTESTATION_DISPLAY=$(PYTHONIOENCODING=utf-8 python << 'PYEOF'
import json, os, sys
try:
    with open(os.environ["_GATE_FILE_DISPLAY"], "r", encoding="utf-8") as fh:
        gate = json.load(fh)
except Exception:
    sys.exit(0)
attestations = gate.get("attestations") or []
if not isinstance(attestations, list) or not attestations:
    sys.exit(0)
print("  Attestations on this gate (%d):" % len(attestations))
for entry in attestations:
    if not isinstance(entry, dict):
        continue
    print("    - kind=%s ref=%s verdict=%s" % (
        entry.get("kind"), entry.get("ref"), entry.get("verdict"),
    ))
PYEOF
        )
        unset _GATE_FILE_DISPLAY
        if [ -n "$ATTESTATION_DISPLAY" ]; then
            echo "$ATTESTATION_DISPLAY"
        fi
    fi
    echo ""
else
    echo "========================================"
    echo "  COMMIT BLOCKED: No review gate found."
    echo ""
    echo "  Every commit requires /lattice:review to pass first."
    echo "  Run /lattice:review -- it writes the gate file when all checks pass."
    echo ""
    echo "  For trivial commits (docs-only, typo, comment):"
    echo "  bash scripts/write-review-gate.sh pass \"trivial fix\""
    echo "========================================"
    exit 1
fi

# --- Step 1: Executor TypeScript build (if executor changed) ---
STAGED_EXECUTOR=$(echo "$STAGED_FILES" | grep -c "^executor/" || true)
if [ "$STAGED_EXECUTOR" -gt 0 ]; then
    echo "--- Step 1: Executor TypeScript build ---"
    echo ""
    if (cd "$EXECUTOR_DIR" && npx tsc --noEmit); then
        echo ""
        echo "  Build passed."
        echo ""
    else
        echo ""
        echo "========================================"
        echo "  COMMIT ABORTED: Executor TypeScript build failed."
        echo "  Run: cd executor && npx tsc --noEmit"
        echo "========================================"
        exit 1
    fi
else
    echo "No executor changes staged -- skipping TypeScript check."
    echo ""
fi

# --- Step 2: Index freshness advisories (non-blocking) ---
echo "--- Step 2: Index freshness ---"
echo ""

INDEX_WARNINGS=""
CODE_FILE_COUNT=$(echo "$STAGED_FILES" | grep -cE '\.(ts|md|yaml|sh)$' || true)

if [ "$CODE_FILE_COUNT" -gt 3 ]; then
    TODO_STAGED=$(echo "$STAGED_FILES" | grep -c "TODO.md" || true)
    if [ "$TODO_STAGED" -eq 0 ]; then
        INDEX_WARNINGS="${INDEX_WARNINGS}  TODO.md: ${CODE_FILE_COUNT} files changed but TODO.md was not updated.\n"
    fi
fi

# Docs freshness: structural changes should update README/WORKFLOW/WORKFLOW-INTERNALS/ENFORCEMENT
STRUCT_CHANGES=$(echo "$STAGED_FILES" | grep -cE '^(executor/src/|commands/|workflows/|scripts/|agents/|hooks/|scaffold/)' || true)
if [ "$STRUCT_CHANGES" -gt 0 ]; then
    DOCS_STAGED=$(echo "$STAGED_FILES" | grep -cE '^(README\.md|WORKFLOW\.md|WORKFLOW-INTERNALS\.md|ENFORCEMENT\.md)$' || true)
    if [ "$DOCS_STAGED" -eq 0 ]; then
        INDEX_WARNINGS="${INDEX_WARNINGS}  DOCS: ${STRUCT_CHANGES} structural file(s) changed but README / WORKFLOW / WORKFLOW-INTERNALS / ENFORCEMENT not updated.\n"
    fi
fi

if [ -n "$INDEX_WARNINGS" ]; then
    echo "  Advisories (non-blocking):"
    echo -e "$INDEX_WARNINGS"
else
    echo "  All indexes look fresh."
fi
echo ""

# --- Step 2.5: Bug retrospective check (BLOCKS on fix: commits) — CLAUDE.md rule 20 ---
# If the commit message (when available via COMMIT_EDITMSG) starts with "fix:",
# verify that the BUG-SWEEP.md entry referenced in the gate has all 5 retro fields.
# Set LATTICE_BUG_RETRO=BUG-XXX before commit to point at the entry; or include
# "Bug-Retro: BUG-XXX" trailer in the commit message.

COMMIT_MSG_FILE="$REPO_ROOT/.git/COMMIT_EDITMSG"
COMMIT_MSG=""
[ -f "$COMMIT_MSG_FILE" ] && COMMIT_MSG=$(cat "$COMMIT_MSG_FILE" 2>/dev/null || echo "")

# Detect bug-fix commit: starts with "fix:" or has "Bug-Retro:" trailer
IS_BUG_FIX=0
BUG_ID=""
if echo "$COMMIT_MSG" | head -1 | grep -qE '^fix(\([^)]+\))?:'; then
    IS_BUG_FIX=1
fi
if echo "$COMMIT_MSG" | grep -qE '^Bug-Retro:'; then
    IS_BUG_FIX=1
    BUG_ID=$(echo "$COMMIT_MSG" | grep -E '^Bug-Retro:' | head -1 | sed 's/Bug-Retro:\s*//' | tr -d ' ')
fi
# Env-var override / explicit binding
[ -n "${LATTICE_BUG_RETRO:-}" ] && { IS_BUG_FIX=1; BUG_ID="$LATTICE_BUG_RETRO"; }

if [ "$IS_BUG_FIX" -eq 1 ]; then
    echo "--- Step 2.5: Bug retrospective (rule 20) ---"
    BUG_SWEEP=""
    for candidate in "$REPO_ROOT/docs/_internal/BUG-SWEEP.md" "$REPO_ROOT/BUG-SWEEP.md"; do
        [ -f "$candidate" ] && { BUG_SWEEP="$candidate"; break; }
    done

    if [ -z "$BUG_SWEEP" ]; then
        echo "  ADVISORY: bug-fix commit detected but no BUG-SWEEP.md found; skipping retro check."
        echo ""
    elif [ -z "$BUG_ID" ]; then
        echo "  COMMIT BLOCKED: bug-fix commit (fix: prefix) requires a Bug-Retro reference."
        echo ""
        echo "  Run /ops:bug-stress (Step 8 — Retrospective) to write the 5-question retro,"
        echo "  then re-commit with one of:"
        echo '    git commit -m "fix: ... " -m "Bug-Retro: BUG-XXX"'
        echo '    LATTICE_BUG_RETRO=BUG-XXX git commit ...'
        echo ""
        echo "  Why: every bug fix is evidence a gate failed. The retro forces the lesson"
        echo "  back into the framework so the same class doesn't recur. CLAUDE.md rule 20."
        exit 1
    else
        # Verify BUG-XXX entry exists and has all 5 retro fields
        MISSING_FIELDS=""
        if ! grep -qE "^### $BUG_ID " "$BUG_SWEEP"; then
            echo "  COMMIT BLOCKED: $BUG_ID entry not found in $BUG_SWEEP"
            echo "  Add an entry with all 5 retrospective questions filled, then re-commit."
            exit 1
        fi
        # Extract the entry (from ### BUG-XXX to next ### BUG- or end of file)
        ENTRY=$(awk -v id="$BUG_ID" '
            $0 ~ "^### "id" " { in_entry=1 }
            in_entry && /^### BUG-/ && $0 !~ "^### "id" " { in_entry=0 }
            in_entry { print }
        ' "$BUG_SWEEP")
        for field in "1\. \*\*Root cause" "2\. \*\*Genesis" "3\. \*\*Detection gap" "4\. \*\*Prevention class" "5\. \*\*Lattice change"; do
            if ! echo "$ENTRY" | grep -qE "$field"; then
                MISSING_FIELDS="${MISSING_FIELDS}  - missing: $(echo $field | sed 's/\\\*//g; s/\\\.//g')\n"
            fi
        done
        if [ -n "$MISSING_FIELDS" ]; then
            echo "  COMMIT BLOCKED: $BUG_ID retrospective is incomplete."
            echo -e "$MISSING_FIELDS"
            echo "  Run /ops:bug-stress Step 8 to fill the missing fields, then re-commit."
            exit 1
        fi
        echo "  PASS: $BUG_ID retrospective complete (all 5 fields present)."
        echo ""
    fi
fi

# --- Step 3: Complexity advisories (non-blocking) ---
echo "--- Step 3: Complexity advisories ---"
echo ""

COMPLEXITY_WARNINGS=""

while IFS= read -r FILE; do
    [ -z "$FILE" ] && continue
    [ ! -f "$REPO_ROOT/$FILE" ] && continue
    case "$FILE" in
        *.ts)
            LINE_COUNT=$(wc -l < "$REPO_ROOT/$FILE" 2>/dev/null)
            if [ "$LINE_COUNT" -gt 800 ]; then
                COMPLEXITY_WARNINGS="${COMPLEXITY_WARNINGS}  WARNING: ${FILE} is ${LINE_COUNT} lines (threshold: 800)\n"
            fi
            ;;
        *.md)
            LINE_COUNT=$(wc -l < "$REPO_ROOT/$FILE" 2>/dev/null)
            if [ "$LINE_COUNT" -gt 500 ]; then
                COMPLEXITY_WARNINGS="${COMPLEXITY_WARNINGS}  ADVISORY: ${FILE} is ${LINE_COUNT} lines -- consider splitting\n"
            fi
            ;;
    esac
done <<< "$STAGED_FILES"

if [ -n "$COMPLEXITY_WARNINGS" ]; then
    echo -e "$COMPLEXITY_WARNINGS"
else
    echo "  No advisories."
fi
echo ""

# --- Step 4: Staging-drift check (BLOCKS on concurrent autopilot interleave) ---
# Re-snapshot the staged file set. If new files appeared during the hook run,
# another process (typically `/lattice:autopilot`) ran `git add` while our
# build/checks were in flight. Those files would silently bundle into our
# commit with our message attached -- a confirmed defect class (see commits
# 1370c103 and 521f1d16, both annotated in decisions.log).
echo "--- Step 4: Staging-drift check ---"
FINAL_STAGED=$(git diff --cached --name-only | sort)
ADDED_DURING_HOOK=$(comm -13 <(echo "$INITIAL_STAGED_SNAPSHOT") <(echo "$FINAL_STAGED") || true)
if [ -n "$ADDED_DURING_HOOK" ]; then
    echo "  COMMIT BLOCKED: files were added to the index DURING this pre-commit run."
    echo ""
    echo "  Files added after pre-commit started (NOT part of your intended commit):"
    echo "$ADDED_DURING_HOOK" | sed 's/^/    - /'
    echo ""
    echo "  Likely cause: a concurrent process (typically /lattice:autopilot) ran"
    echo "  'git add' while this pre-commit was running its build/test checks."
    echo "  The added files would silently bundle into your commit with your"
    echo "  message attached -- a defect class with confirmed precedent in this"
    echo "  codebase (commits 1370c103 and 521f1d16, see decisions.log)."
    echo ""
    echo "  Resolve:"
    echo "    1. Pause the concurrent process (/lattice:autopilot or similar)."
    echo "    2. git reset HEAD <each unintended file>"
    echo "    3. Verify: git diff --cached --name-only matches your intended scope."
    echo "    4. Re-run /lattice:review (or write-review-gate.sh) for a fresh gate."
    echo "    5. Re-commit."
    exit 1
fi
echo "  PASS: staged file set unchanged during pre-commit run."
echo ""

# --- Cleanup: Consume the review gate (single-use) ---
if [ -f "$GATE_FILE" ]; then
    rm -f "$GATE_FILE"
    echo "  Review gate consumed (next commit needs fresh /lattice:review)."
    echo ""
fi

echo "========================================"
echo "  All pre-commit checks passed."
echo "========================================"
exit 0
